   :drag-drop-target-rounding       [cpp/ImGuiStyleVar_DragDropTargetRounding :float]
   :button-text-align               [cpp/ImGuiStyleVar_ButtonTextAlign :vec2]
   :selectable-text-align           [cpp/ImGuiStyleVar_SelectableTextAlign :vec2]
   :separator-size                  [cpp/ImGuiStyleVar_SeparatorSize :float]
   :separator-text-border-size      [cpp/ImGuiStyleVar_SeparatorTextBorderSize :float]
   :separator-text-align            [cpp/ImGuiStyleVar_SeparatorTextAlign :vec2]
   :separator-text-padding          [cpp/ImGuiStyleVar_SeparatorTextPadding :vec2]})

(defn push-style-var [var value]
  (if-let [[key type] (get style-vars-map var)]
    (case type
      ;; TODO(jank): should not need cpp/int here
      :float (cpp/ImGui.PushStyleVar (cpp/int key) (float value))
      :vec2  (cpp/ImGui.PushStyleVar (cpp/int key) (vec2 value)))
    (throw (ex-info "invalid imgui style var" {:var var}))))

(defn pop-style-var
  ([] (pop-style-var 1))
  ([n] (cpp/ImGui.PopStyleVar n)))

