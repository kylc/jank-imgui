(ns imgui.ui
  (:require [imgui.util :refer [parse-flags]])
  (:include "imgui.h"
            "misc/cpp/imgui_stdlib.h"))

(defmacro vec2
  "Coerce to ImVec2."
  ([xy] `(let [[x# y#] ~xy] (vec2 x# y#)))
  ([x y] `(cpp/ImVec2. (float ~x) (float ~y))))

(defmacro vec2-> [v]
  `[(cpp/.-x ~v) (cpp/.-y ~v)])

(defmacro vec4
  "Coerce to ImVec4."
  ([xyzw] `(let [[x# y# z# w#] ~xyzw] (vec4 x# y# z# w#)))
  ([x y z w] `(cpp/ImVec4. (float ~x) (float ~y) (float ~z) (float ~w))))

(defmacro vec4-> [v]
  `[(cpp/.-x ~v) (cpp/.-y ~v) (cpp/.-z ~v) (cpp/.-w ~v)])

(defn display-size []
  (let [io (cpp/ImGui.GetIO)]
    (vec2-> (.-DisplaySize io))))

(defn cursor-screen-pos []
  (vec2-> (cpp/ImGui.GetCursorScreenPos)))

(defn content-region-avail []
  (vec2-> (cpp/ImGui.GetContentRegionAvail)))

(defn set-cursor-pos [v]
  (cpp/ImGui.SetCursorPos (vec2 v)))

(defn set-cursor-pos-x [x]
  (cpp/ImGui.SetCursorPosX (float x)))

(defn set-cursor-pos-y [y]
  (cpp/ImGui.SetCursorPosY (float y)))

(defn calc-text-size [s]
  (vec2-> (cpp/ImGui.CalcTextSize s)))

;; - Windows ------------------------------------------------------------

(def window-flag-map
  {:none                        cpp/ImGuiWindowFlags_None
   :no-title-bar                cpp/ImGuiWindowFlags_NoTitleBar
   :no-resize                   cpp/ImGuiWindowFlags_NoResize
   :no-move                     cpp/ImGuiWindowFlags_NoMove
   :no-scrollbar                cpp/ImGuiWindowFlags_NoScrollbar
   :no-scroll-with-mouse        cpp/ImGuiWindowFlags_NoScrollWithMouse
   :no-collapse                 cpp/ImGuiWindowFlags_NoCollapse
   :always-auto-resize          cpp/ImGuiWindowFlags_AlwaysAutoResize
   :no-background               cpp/ImGuiWindowFlags_NoBackground
   :no-saved-settings           cpp/ImGuiWindowFlags_NoSavedSettings
   :no-mouse-inputs             cpp/ImGuiWindowFlags_NoMouseInputs
   :menu-bar                    cpp/ImGuiWindowFlags_MenuBar
   :horizontal-scrollbar        cpp/ImGuiWindowFlags_HorizontalScrollbar
   :no-focus-on-appearing       cpp/ImGuiWindowFlags_NoFocusOnAppearing
   :no-bring-to-front-on-focus  cpp/ImGuiWindowFlags_NoBringToFrontOnFocus
   :always-vertical-scrollbar   cpp/ImGuiWindowFlags_AlwaysVerticalScrollbar
   :always-horizontal-scrollbar cpp/ImGuiWindowFlags_AlwaysHorizontalScrollbar
   :no-nav-inputs               cpp/ImGuiWindowFlags_NoNavInputs
   :no-nav-focus                cpp/ImGuiWindowFlags_NoNavFocus
   :unsaved-document            cpp/ImGuiWindowFlags_UnsavedDocument
   :no-nav                      cpp/ImGuiWindowFlags_NoNav
   :no-decoration               cpp/ImGuiWindowFlags_NoDecoration
   :no-inputs                   cpp/ImGuiWindowFlags_NoInputs})

(defn begin
  "Push a new window to the stack."
  [{:keys [name pos size collapsed? min-size max-size bg-alpha window-flags]
    :or   {name ""}}]
  (when (some? pos) (cpp/ImGui.SetNextWindowPos (vec2 pos) cpp/ImGuiCond_Always))
  (when (some? size) (cpp/ImGui.SetNextWindowSize (vec2 size) cpp/ImGuiCond_Always))
  (when (some? collapsed?) (cpp/ImGui.SetNextWindowCollapsed collapsed? cpp/ImGuiCond_Always))
  (when (some? (or min-size max-size))
    (cpp/ImGui.SetNextWindowSizeConstraints (vec2 (or min-size [0.0 0.0]))
                                            (vec2 (or max-size [0.0 0.0]))))
  (when (some? bg-alpha) (cpp/ImGui.SetNextWindowBgAlpha bg-alpha))
  (cpp/ImGui.Begin name cpp/nullptr (parse-flags window-flag-map window-flags)))

(defn end
  "Pop the current window from the stack."
  []
  (cpp/ImGui.End))

(defmacro with-window
  "Wrap an expression inside a new window.

  If the window is closed then the body will not be evaluated. Prefer
  this over manual calls to [[begin]] and [[end]]. See [[begin]] for
  allowed options.

  Returns true/false to indicate the window is open/closed."
  ([attrs & body]
   `(let [open?# (begin ~attrs)]
      (when open?#
        ~@body)
      (end)
      open?#)))

(def child-flag-map
  {:borders                   cpp/ImGuiChildFlags_Borders
   :always-use-window-padding cpp/ImGuiChildFlags_AlwaysUseWindowPadding
   :resize-x                  cpp/ImGuiChildFlags_ResizeX
   :resize-y                  cpp/ImGuiChildFlags_ResizeY
   :auto-resize-x             cpp/ImGuiChildFlags_AutoResizeX
   :auto-resize-y             cpp/ImGuiChildFlags_AutoResizeY
   :always-auto-resize        cpp/ImGuiChildFlags_AlwaysAutoResize
   :frame-style               cpp/ImGuiChildFlags_FrameStyle
   :nav-flattened             cpp/ImGuiChildFlags_NavFlattened})

(defn begin-child
  [{:keys [name size child-flags window-flags]
    :or   {name "" size [0.0 0.0]}
    :as   attrs}]
  ;; TODO(jank): overload resolution fails without int cast
  (let [wflags (int (parse-flags window-flag-map window-flags))
        cflags (int (parse-flags child-flag-map child-flags))]
    ;; TODO(jank): jank compiler fails without string cast
    (cpp/ImGui.BeginChild (.c_str (cpp/cast std.string name)) (vec2 size) cflags wflags)))

(defn end-child
  []
  (cpp/ImGui.EndChild))

(defmacro with-child
  ([attrs & body]
   `(do
      (let [open?# (begin-child ~attrs)]
        (when open?#
          ~@body)
        (end-child)
        open?#))))

;; - Widgets: text -------------------------------------------------------

(defn text [s]
  (cpp/ImGui.TextUnformatted s))

;; - Widgets: main -------------------------------------------------------

(defn button
  [{:keys [label size on-click]
    :or   {label "" size [0.0 0.0]}}]
  (when (cpp/ImGui.Button label (vec2 size))
    (when on-click
      (on-click))))

(defn small-button [{:keys [label]}]
  (cpp/ImGui.SmallButton label))

(defn checkbox [{:keys [label checked?]}]
  (let [v (cpp/bool checked?)]
    (cpp/ImGui.Checkbox label (cpp/& v))
    v))

(defn radio-button [{:keys [label active?]}]
  (cpp/ImGui.RadioButton label active?))

(defn progress-bar [fraction]
  (cpp/ImGui.ProgressBar fraction))

(defn bullet []
  (cpp/ImGui.Bullet))

(defn text-link
  ([label] (cpp/ImGui.TextLink label))
  ([label url] (cpp/ImGui.TextLinkOpenURL label url)))

;; - Widgets: images -----------------------------------------------------
;; - Widgets: combo box --------------------------------------------------

(defn begin-combo [{:keys [label preview-value]
                    :or   {preview-value ""}}]
  (cpp/ImGui.BeginCombo label preview-value))

(defn end-combo []
  (cpp/ImGui.EndCombo))

(defmacro with-combo [attrs & body]
  `(when (begin-combo ~attrs)
     ~@body
     (end-combo)))

;; - Widgets: drag sliders -----------------------------------------------
;; - Widgets: regular sliders --------------------------------------------
;; - Widgets: input with keyboard ----------------------------------------

(cpp/raw "
namespace imgui::ui {
  inline jtl::immutable_string input_text(jtl::immutable_string const &label,
                                          jtl::immutable_string const &s) {
    std::string v { s };
    ImGui::InputText(label.c_str(), &v);
    return { v };
  }

  inline jtl::immutable_string input_text_multiline(jtl::immutable_string const &label,
                                                    jtl::immutable_string const &s) {
    std::string v { s };
    ImGui::InputTextMultiline(label.c_str(), &v);
    return { v };
  }
}
")

(defn input-text [label text]
  ;; TODO(jank): jank struggles with the ImGui.InputText signature,
  ;; resolving const vs. non-const args, etc. Use a C++ shim for now.
  (cpp/imgui.ui.input_text label text))

(defn input-text-multiline [label text]
  ;; TODO(jank): jank struggles with the ImGui.InputText signature,
  ;; resolving const vs. non-const args, etc. Use a C++ shim for now.
  (cpp/imgui.ui.input_text_multiline label text))

;; - Widgets: color editor / picker --------------------------------------
;; - Widgets: trees ------------------------------------------------------
;; - Widgets: selectables ------------------------------------------------

(defn selectable [label selected?]
  ;; TODO(jank): jank incorrectly says this function is not viable
  ;; without the cast to std.string.
  (cpp/ImGui.Selectable (.c_str (cpp/cast std.string label)) selected?))

