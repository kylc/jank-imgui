;; - Layout -------------------------------------------------------------

(defn separator
  ([] (cpp/ImGui.Separator))
  ([text] (cpp/ImGui.SeparatorText text)))

(defn same-line []
  (cpp/ImGui.SameLine))

(defn new-line []
  (cpp/ImGui.NewLine))

(defn dummy [size]
  (cpp/ImGui.Dummy (vec2 size)))

