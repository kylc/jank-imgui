   :disabled-alpha                  [cpp/ImGuiStyleVar_DisabledAlpha :float]
   :window-padding                  [cpp/ImGuiStyleVar_WindowPadding :vec2]
   :window-rounding                 [cpp/ImGuiStyleVar_WindowRounding :float]
   :window-border-size              [cpp/ImGuiStyleVar_WindowBorderSize :float]
   :window-min-size                 [cpp/ImGuiStyleVar_WindowMinSize :vec2]
   :window-title-align              [cpp/ImGuiStyleVar_WindowTitleAlign :vec2]
   :child-rounding                  [cpp/ImGuiStyleVar_ChildRounding :float]
   :child-border-size               [cpp/ImGuiStyleVar_ChildBorderSize :float]
   :popup-rounding                  [cpp/ImGuiStyleVar_PopupRounding :float]
   :popup-border-size               [cpp/ImGuiStyleVar_PopupBorderSize :float]
   :frame-padding                   [cpp/ImGuiStyleVar_FramePadding :vec2]
   :frame-rounding                  [cpp/ImGuiStyleVar_FrameRounding :float]
   :frame-border-size               [cpp/ImGuiStyleVar_FrameBorderSize :float]
   :item-spacing                    [cpp/ImGuiStyleVar_ItemSpacing :vec2]
   :item-inner-spacing              [cpp/ImGuiStyleVar_ItemInnerSpacing :vec2]
   :indent-spacing                  [cpp/ImGuiStyleVar_IndentSpacing :float]
   :cell-padding                    [cpp/ImGuiStyleVar_CellPadding :vec2]
   :scrollbar-size                  [cpp/ImGuiStyleVar_ScrollbarSize :float]
   :scrollbar-rounding              [cpp/ImGuiStyleVar_ScrollbarRounding :float]
   :scrollbar-padding               [cpp/ImGuiStyleVar_ScrollbarPadding :float]
   :grab-min-size                   [cpp/ImGuiStyleVar_GrabMinSize :float]
   :grab-rounding                   [cpp/ImGuiStyleVar_GrabRounding :float]
   :image-rounding                  [cpp/ImGuiStyleVar_ImageRounding :float]
   :image-border-size               [cpp/ImGuiStyleVar_ImageBorderSize :float]
   :tab-rounding                    [cpp/ImGuiStyleVar_TabRounding :float]
   :tab-border-size                 [cpp/ImGuiStyleVar_TabBorderSize :float]
   :tab-min-width-base              [cpp/ImGuiStyleVar_TabMinWidthBase :float]
   :tab-min-width-shrink            [cpp/ImGuiStyleVar_TabMinWidthShrink :float]
   :tab-bar-border-size             [cpp/ImGuiStyleVar_TabBarBorderSize :float]
   :tab-bar-overline-size           [cpp/ImGuiStyleVar_TabBarOverlineSize :float]
   :table-angled-headers-angle      [cpp/ImGuiStyleVar_TableAngledHeadersAngle :float]
   :table-angled-headers-text-align [cpp/ImGuiStyleVar_TableAngledHeadersTextAlign :vec2]
   :tree-lines-size                 [cpp/ImGuiStyleVar_TreeLinesSize :float]
