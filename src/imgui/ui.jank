   :text-disabled                cpp/ImGuiCol_TextDisabled
   :window-bg                    cpp/ImGuiCol_WindowBg
   :child-bg                     cpp/ImGuiCol_ChildBg
   :popup-bg                     cpp/ImGuiCol_PopupBg
   :border                       cpp/ImGuiCol_Border
   :border-shadow                cpp/ImGuiCol_BorderShadow
   :frame-bg                     cpp/ImGuiCol_FrameBg
   :frame-bg-hovered             cpp/ImGuiCol_FrameBgHovered
   :frame-bg-active              cpp/ImGuiCol_FrameBgActive
   :title-bg                     cpp/ImGuiCol_TitleBg
   :title-bg-active              cpp/ImGuiCol_TitleBgActive
   :title-bg-collapsed           cpp/ImGuiCol_TitleBgCollapsed
   :menu-bar-bg                  cpp/ImGuiCol_MenuBarBg
   :scrollbar-bg                 cpp/ImGuiCol_ScrollbarBg
   :scrollbar-grab               cpp/ImGuiCol_ScrollbarGrab
   :scrollbar-grab-hovered       cpp/ImGuiCol_ScrollbarGrabHovered
   :scrollbar-grab-active        cpp/ImGuiCol_ScrollbarGrabActive
   :check-mark                   cpp/ImGuiCol_CheckMark
   :checkbox-selected-bg         cpp/ImGuiCol_CheckboxSelectedBg
   :slider-grab                  cpp/ImGuiCol_SliderGrab
   :slider-grab-active           cpp/ImGuiCol_SliderGrabActive
   :button                       cpp/ImGuiCol_Button
   :button-hovered               cpp/ImGuiCol_ButtonHovered
   :button-active                cpp/ImGuiCol_ButtonActive
   :header                       cpp/ImGuiCol_Header
   :header-hovered               cpp/ImGuiCol_HeaderHovered
   :header-active                cpp/ImGuiCol_HeaderActive
   :separator                    cpp/ImGuiCol_Separator
   :separator-hovered            cpp/ImGuiCol_SeparatorHovered
   :separator-active             cpp/ImGuiCol_SeparatorActive
   :resize-grip                  cpp/ImGuiCol_ResizeGrip
   :resize-grip-hovered          cpp/ImGuiCol_ResizeGripHovered
   :resize-grip-active           cpp/ImGuiCol_ResizeGripActive
   :input-text-cursor            cpp/ImGuiCol_InputTextCursor
   :tab-hovered                  cpp/ImGuiCol_TabHovered
   :tab                          cpp/ImGuiCol_Tab
   :tab-selected                 cpp/ImGuiCol_TabSelected
   :tab-selected-overline        cpp/ImGuiCol_TabSelectedOverline
   :tab-dimmed                   cpp/ImGuiCol_TabDimmed
   :tab-dimmed-selected          cpp/ImGuiCol_TabDimmedSelected
   :tab-dimmed-selected-overline cpp/ImGuiCol_TabDimmedSelectedOverline
   :plot-lines                   cpp/ImGuiCol_PlotLines
   :plot-lines-hovered           cpp/ImGuiCol_PlotLinesHovered
   :plot-histogram               cpp/ImGuiCol_PlotHistogram
   :plot-histogram-hovered       cpp/ImGuiCol_PlotHistogramHovered
   :table-header-bg              cpp/ImGuiCol_TableHeaderBg
   :table-border-strong          cpp/ImGuiCol_TableBorderStrong
   :table-border-light           cpp/ImGuiCol_TableBorderLight
   :table-row-bg                 cpp/ImGuiCol_TableRowBg
   :table-row-bg-alt             cpp/ImGuiCol_TableRowBgAlt
   :text-link                    cpp/ImGuiCol_TextLink
   :text-selected-bg             cpp/ImGuiCol_TextSelectedBg
   :tree-lines                   cpp/ImGuiCol_TreeLines
   :drag-drop-target             cpp/ImGuiCol_DragDropTarget
   :drag-drop-target-bg          cpp/ImGuiCol_DragDropTargetBg
   :unsaved-marker               cpp/ImGuiCol_UnsavedMarker
   :nav-cursor                   cpp/ImGuiCol_NavCursor
   :nav-windowing-highlight      cpp/ImGuiCol_NavWindowingHighlight
   :nav-windowing-dim-bg         cpp/ImGuiCol_NavWindowingDimBg
   :modal-window-dim-bg          cpp/ImGuiCol_ModalWindowDimBg})

(defn push-style-color [var value]
  (if-let [key (get style-colors-map var)]
    ;; TODO(jank): should not need cpp/int here
    (cpp/ImGui.PushStyleColor (cpp/int key) (vec4 value))
    (throw (ex-info "invalid imgui style color" {:color var}))))

(defn pop-style-color
  ([] (cpp/ImGui.PopStyleColor))
  ([n] (cpp/ImGui.PopStyleColor n)))

(defn push-id [id]
  (cpp/ImGui.PushID (.c_str (cpp/cast std.string id))))

(defn pop-id []
  (cpp/ImGui.PopID))

(defmacro with-scope
  "Supported keys are are :id (see [[push-id]]), :style (see
  [[push-style-var]] for options), :color (see [[push-style-color]]
  for options), etc."
  [attrs & body]
  `(let [attrs# ~attrs]
     (doseq [[k# v#] (:style attrs#)] (push-style-var k# v#))
     (doseq [[k# v#] (:color attrs#)] (push-style-color k# v#))
     (when (:id attrs#) (push-id (:id attrs#)))
     ~@body
     (when (:id attrs#) (pop-id))
     (pop-style-color (count (:color attrs#)))
     (pop-style-var (count (:style attrs#)))))
